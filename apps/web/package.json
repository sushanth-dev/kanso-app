{
  "name": "@chess-app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:tokens": "node scripts/build-tokens.mjs",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/generated/api.ts",
    "generate": "npm run generate:tokens && npm run generate:api",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-table": "^9.1.2",
    "better-auth": "^1.6.28",
    "chess.js": "^1.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.417.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@iconify-json/solar": "^1.2.10",
    "@playwright/test": "^1.62.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "style-dictionary": "^5.5.1",
    "tailwindcss": "^4.3.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1"
  }
}
