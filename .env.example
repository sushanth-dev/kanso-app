# Copy to .env and fill in. .env is gitignored and must stay that way: a
# connection string is a credential, and .gitleaks.toml has a rule that will
# stop one reaching a commit.
#
# Each variable here is read by something in the code; the file grows a line
# when something grows a `process.env` that needs it, and not before.

# The PostgreSQL the API and the integration tests talk to.
#
# PostgreSQL 18 (ADR-0022). docs/guides/local-setup.md has the container
# command that gives you one matching what CI and production run.
#
# The integration suite resets state between tests, so this must never point
# at a database whose contents you care about.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kanso_dev

# The secret better-auth signs session cookies with (ADR-0011). A real value
# must be at least 32 characters and randomly generated, never committed.
# Generate one with `openssl rand -base64 32`.
#
# The integration suite needs one set too, because it signs up and signs in
# real users through the better-auth handler.
BETTER_AUTH_SECRET=

# The address SES sends the guardian consent notice from. Must be a verified
# SES identity. Left unset, the consent flow fails loud rather than silently
# dropping the notice.
SES_FROM_ADDRESS=

# The public origin the consent confirm link points at. The confirm route is
# served there as /guardians/confirm/{token}. Defaults to
# http://localhost:3000 when unset.
APP_ORIGIN=
