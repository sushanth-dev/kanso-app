# Copy to .env and fill in. .env is gitignored and must stay that way: a
# connection string is a credential, and .gitleaks.toml has a rule that will
# stop one reaching a commit.
#
# Each variable here is read by something in the code; the file grows a line
# when something grows a `process.env` that needs it, and not before.

# The PostgreSQL the API and the integration tests talk to.
#
# PostgreSQL 18 (ADR-0022). docs/guides/local-setup.md has the container
# command that gives you one matching what CI and production run.
#
# The integration suite resets state between tests, so this must never point
# at a database whose contents you care about.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kanso_dev

# The secret better-auth signs session cookies with (ADR-0011). A real value
# must be at least 32 characters and randomly generated, never committed.
# Generate one with `openssl rand -base64 32`.
#
# The integration suite needs one set too, because it signs up and signs in
# real users through the better-auth handler.
BETTER_AUTH_SECRET=

# The sign-in rate limit (ST-021, closes DEBT-008): the number of failed
# sign-in attempts one source gets within the window before better-auth
# answers 429, and the window length in seconds. Production enables the limit
# automatically (NODE_ENV=production); set SIGN_IN_RATE_LIMIT_ENABLED=true to
# exercise it locally or in a test.
SIGN_IN_RATE_LIMIT_MAX=5
SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=300
SIGN_IN_RATE_LIMIT_ENABLED=

# The address SES sends the guardian consent notice from. Must be a verified
# SES identity. Left unset, the consent flow fails loud rather than silently
# dropping the notice.
SES_FROM_ADDRESS=

# The public origin the consent confirm link points at. The confirm route is
# served there as /guardians/confirm/{token}. Defaults to
# http://localhost:3000 when unset.
APP_ORIGIN=

# The port the API serves on. Defaults to 3000 when unset. Only server.ts reads
# it; the Hono app itself is portless, which is what makes it testable without
# binding one.
PORT=3000

# The endpoint the AWS SDK clients (SQS, SES) point at. Only ever LocalStack;
# unset in every deployed environment, where the SDK resolves the real region
# and credentials. Set it to http://localhost:4566 to run the queue and mailer
# integration tests against LocalStack; unset, those tests skip rather than
# talk to real AWS.
AWS_ENDPOINT_URL=

# The SQS queue analysis messages are sent to (ADR-0023). Left unset, the API
# imports games without queueing them, which is the path the rest of the
# integration suite runs on. infra/analysis.ts creates the real queue; the
# LocalStack integration tests create and delete their own.
ANALYSIS_QUEUE_URL=

# The number of analysis attempts before a failure is final. Must match the
# queue's redrive policy in infra/analysis.ts. Defaults to 3 when unset.
ANALYSIS_MAX_ATTEMPTS=3
