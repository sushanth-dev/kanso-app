# Copy to .env and fill in. Local-development-only vars go in .env.local
# instead. Both files are gitignored (.env and .env.* in .gitignore) and must
# stay that way: a connection string is a credential, and .gitleaks.toml has a
# rule that will stop one reaching a commit.
#
# The split matters because sst deploy loads .env and .env.{stage} but never
# .env.local, so a LocalStack endpoint in .env.local cannot redirect a deploy.
# server.ts and the integration tests load .env then .env.local.
#
# Each variable here is read by something in the code; the file grows a line
# when something grows a `process.env` that needs it, and not before.

# The PostgreSQL the API and the integration tests talk to. Put this in
# .env.local, not .env: it is local-only and sst deploy never reads it.
#
# PostgreSQL 18 (ADR-0022). docs/guides/local-setup.md has the container
# command that gives you one matching what CI and production run.
#
# The integration suite resets state between tests, so this must never point
# at a database whose contents you care about.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kanso_dev

# The secret better-auth signs session cookies with (ADR-0011). A real value
# must be at least 32 characters and randomly generated, never committed.
# Generate one with `openssl rand -base64 32`.
#
# The integration suite needs one set too, because it signs up and signs in
# real users through the better-auth handler.
BETTER_AUTH_SECRET=

# The sign-in rate limit (ST-021, closes DEBT-008): the number of failed
# sign-in attempts one source gets within the window before better-auth
# answers 429, and the window length in seconds. Production enables the limit
# automatically (NODE_ENV=production); set SIGN_IN_RATE_LIMIT_ENABLED=true to
# exercise it locally or in a test.
SIGN_IN_RATE_LIMIT_MAX=5
SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=300
SIGN_IN_RATE_LIMIT_ENABLED=

# The address the guardian consent notice sends from. Must be the verified
# kansochess.app identity: SPF and DKIM for the domain live in the Resend
# dashboard (ADR-0042). Left unset, the consent flow fails loud rather than
# silently dropping the notice.
MAIL_FROM_ADDRESS=

# The Resend API key every outbound email sends with (ADR-0042). Create one
# at https://resend.com/api-keys and put the value in .env, the file
# `sst deploy` reads at deploy time; for local development .env.local also
# works (server.ts and the integration tests load it). Left unset, mail is
# down loudly: the consent flow fails rather than issuing a consent link that
# was never mailed. Never commit a real value.
RESEND_API_KEY=

# The public origin the consent confirm link points at. The confirm route is
# served there as /guardians/confirm/{token}. Defaults to
# http://localhost:3000 when unset.
APP_ORIGIN=

# The port the API serves on. Defaults to 3000 when unset. Only server.ts reads
# it; the Hono app itself is portless, which is what makes it testable without
# binding one.
PORT=3000

# The endpoint the AWS SDK client (SQS) points at. Only ever LocalStack,
# so it lives in .env.local, never .env; in every deployed environment it is
# unset and the SDK resolves the real region and credentials. Set it to
# http://localhost:4566 to run the queue integration tests against LocalStack;
# unset, those tests skip rather than talk to real AWS.
AWS_ENDPOINT_URL=

# The SQS queue analysis messages are sent to (ADR-0023). Left unset, the API
# imports games without queueing them, which is the path the rest of the
# integration suite runs on. infra/analysis.ts creates the real queue; the
# LocalStack integration tests create and delete their own.
ANALYSIS_QUEUE_URL=

# The number of analysis attempts before a failure is final. Must match the
# queue's redrive policy in infra/analysis.ts. Defaults to 3 when unset.
ANALYSIS_MAX_ATTEMPTS=3

# The public origin the deployed web bundle calls as its API (ST-030 Part 2).
# Set by infra/web.ts at build time from the API hostname, so Vite bakes in the
# deployed origin rather than localhost. Unset locally, the web falls back to
# its own origin and the Vite proxy keeps working.
VITE_API_URL=

# The web origins allowed to hold a session against the deployed API
# (ST-030 Part 2), comma-separated. Feeds both Hono CORS and better-auth's
# trustedOrigins, so there is one allowlist rather than two. Set by
# infra/api.ts from the web hostname. Unset locally, the CORS middleware is a
# no-op and the Vite proxy keeps everything same-origin.
CORS_ORIGINS=

# The Cloudflare account the web deploys to (ST-030 Part 2). Not a secret; it
# is the id in the Cloudflare dashboard URL. SST reads it as the default
# account for every sst.cloudflare.* component.
CLOUDFLARE_DEFAULT_ACCOUNT_ID=68c7fe9e23c6380faf9992958f3c3377

# A Cloudflare API token scoped to Workers Scripts (Edit) on the account and
# Zone (Read) on the kansochess.app zone. The custom-domain step auto-creates
# the web record, so no DNS permission is needed. See docs/guides/deploy.md.
# Generate one in the dashboard; never commit a real value.
CLOUDFLARE_API_TOKEN=

# The Razorpay credentials the billing routes read (ADR-0039, ST-044). The key
# id and key secret authenticate the order API; the webhook secret verifies
# Razorpay's signature on payment confirmations. Left unset, the billing routes
# are not mounted. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The PostHog public client key (ADR-0038, amended 2026-09-03, ST-112).
# Public by design: the JS SDK ships it to the browser, so a real value is not
# a secret. The web build reads it from apps/web/.env, Vite's env dir. Unset,
# the web sends nothing at all. The key carries the whole suite: web
# analytics, session replay, surveys, the support widget, feature flags, and
# error tracking.
VITE_POSTHOG_KEY=
# The API reads the same token as POSTHOG_KEY for server-side exception
# capture (ADR-0038, second amendment). Public, not a secret; a real value is
# the project token above.
POSTHOG_KEY=

# The Z.AI API key the mistake-explanation and Socratic-question routes and
# the report's advice and summary read (ADR-0018, ADR-0041). Create one at
# https://z.ai/manage-apikey/apikey-list and put the value in .env, the file
# `sst deploy` reads at deploy time; for local development .env.local also
# works (server.ts and the integration tests load it). Left unset, the coach
# routes are not mounted and the report prose falls back to its templates.
# Never commit a real value. ZAI_MODEL defaults to glm-5.3-flash when unset.
ZAI_API_KEY=
ZAI_MODEL=
